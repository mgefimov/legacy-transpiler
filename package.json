{
  "name": "legacy-transpiler",
  "version": "0.1.4",
  "description": "TypeScript library for transpiling JavaScript for old iOS devices",
  "main": "dist/legacy-transpiler.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/legacy-transpiler.js --target=ios12 --format=iife --global-name=LegacyTranspiler",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/run.ts",
    "serve": "npx serve site"
  },
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.0",
    "astring": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
